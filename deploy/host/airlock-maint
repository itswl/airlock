#!/usr/bin/env bash
# The only thing the host-maint worker's SSH key can run. authorized_keys binds
# the key to this script:
#
#   command="<path>/airlock-maint",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty ssh-ed25519 AAAA... airlock host-maint
#
# so whatever the worker asks for arrives in SSH_ORIGINAL_COMMAND and only the
# actions below exist. Every call is appended to AIRLOCK_MAINT_LOG (the host's
# own record of what the worker did), allowed or not.
set -u
LOG="${AIRLOCK_MAINT_LOG:-$HOME/airlock-deploy/host-maint.log}"
request="${SSH_ORIGINAL_COMMAND:-}"
stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }
log() { printf '%s\t%s\t%s\t%s\n' "$(stamp)" "${SSH_CLIENT%% *}" "$request" "$1" >> "$LOG"; }

case "$request" in
  disk-report)
    df -hP / ; echo ; docker system df
    ;;
  prune-dangling-images)
    docker image prune -f
    ;;
  prune-build-cache)
    docker builder prune -f --filter until=72h
    ;;
  *)
    log "refused"
    echo "not allowed: '$request' (this key runs only: disk-report, prune-dangling-images, prune-build-cache)" >&2
    exit 2
    ;;
esac
status=$?
log "exit=$status"
exit $status
